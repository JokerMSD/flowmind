  },
  "dependencies": {
    "@flowmind/channel-core": "workspace:*",
    "@flowmind/channel-runtime": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "pino": "9.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
